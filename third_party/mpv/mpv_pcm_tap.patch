diff --git a/audio/filter/af_lumen.c b/audio/filter/af_lumen.c
new file mode 100644
--- /dev/null
+++ b/audio/filter/af_lumen.c
@@ -0,0 +1,85 @@
+/* LumenPlayer same-connection PCM tap. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <math.h>
+
+#include "audio/aframe.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "common/global.h"
+#include "filters/f_autoconvert.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "player/client.h"
+
+struct priv {
+    struct mp_pin *input;
+    bool eof_sent;
+};
+
+static void af_lumen_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    if (!mp_pin_in_needs_data(f->ppins[1]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(p->input);
+    if (frame.type == MP_FRAME_AUDIO) {
+        p->eof_sent = false;
+        struct mp_aframe *af = frame.data;
+        int samples = mp_aframe_get_size(af);
+        if (samples > 0) {
+            double pts = mp_aframe_get_pts(af);
+            uint8_t **data = mp_aframe_get_data_ro(af);
+            mp_client_lumen_audio(f->global->client_api, (const float *)data[0],
+                samples, mp_aframe_get_rate(af), mp_aframe_get_channels(af),
+                pts == MP_NOPTS_VALUE ? NAN : pts);
+        }
+    } else if (frame.type == MP_FRAME_EOF && !p->eof_sent) {
+        p->eof_sent = true;
+        mp_client_lumen_audio(f->global->client_api, NULL, 0, 0, 0, NAN);
+    }
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static void af_lumen_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    p->eof_sent = false;
+}
+
+static const struct mp_filter_info af_lumen_filter = {
+    .name = "lumen",
+    .priv_size = sizeof(struct priv),
+    .process = af_lumen_process,
+    .reset = af_lumen_reset,
+};
+
+static struct mp_filter *af_lumen_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &af_lumen_filter);
+    talloc_free(options);
+    if (!f)
+        return NULL;
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct mp_autoconvert *conv = mp_autoconvert_create(f);
+    if (!conv) {
+        talloc_free(f);
+        return NULL;
+    }
+    // Format only: preserve the source rate, layout, PTS and frame attributes.
+    mp_autoconvert_add_afmt(conv, AF_FORMAT_FLOAT);
+    mp_pin_connect(conv->f->pins[0], f->ppins[0]);
+    struct priv *p = f->priv;
+    p->input = conv->f->pins[1];
+    return f;
+}
+
+const struct mp_user_filter_entry af_lumen = {
+    .desc = {
+        .description = "LumenPlayer same-connection PCM audio callback",
+        .name = "lumen",
+    },
+    .create = af_lumen_create,
+};
diff --git a/include/mpv/lumen.h b/include/mpv/lumen.h
new file mode 100644
--- /dev/null
+++ b/include/mpv/lumen.h
@@ -0,0 +1,53 @@
+/* LumenPlayer extension to the pinned libmpv build. SPDX-License-Identifier: ISC */
+#ifndef MPV_CLIENT_API_LUMEN_H_
+#define MPV_CLIENT_API_LUMEN_H_
+
+#include "client.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Receive audio from the built-in "lumen" filter. Samples are interleaved
+ * float PCM; samples is the frame count per channel, not the float count.
+ * rate and channels describe this block. pts is its media timestamp in seconds,
+ * or NaN when unknown. The buffer is valid only until the callback returns.
+ * A NULL buffer with samples == 0 signals EOF; rate/channels are then zero and
+ * pts is NaN. Reset/seek is not EOF and does not produce this signal.
+ *
+ * This runs synchronously on a playback/filter thread and MUST return promptly.
+ * Only copy/enqueue bounded data here. Do not call any mpv API, wait for another
+ * thread that uses mpv, or destroy a handle from inside this callback.
+ *
+ * A filter can prefetch audio while paused and ahead of audible playback. The
+ * host must gate delivery using its pause/seek generation and media clock.
+ * Encoded passthrough has no PCM; disable passthrough while using this filter.
+ */
+typedef void (*mpv_lumen_audio_callback)(void *opaque, const float *pcm,
+                                       int samples, int rate, int channels,
+                                       double pts);
+
+/**
+ * Register the callback for the core used by ctx. Insert "lumen" in --af to
+ * enable delivery. This is a Lumen extension, not an upstream libmpv API.
+ * Only one handle can own a registration per core. A different handle receives
+ * MPV_ERROR_INVALID_PARAMETER until that registration is cleared.
+ *
+ * Pass callback == NULL to unregister this handle's callback; opaque is then
+ * ignored. On return no callback from that registration is in flight. Clearing
+ * a different handle's registration is a successful no-op. Destroying the
+ * owning handle also unregisters synchronously. As with other libmpv APIs, the
+ * caller must not race a call against destruction of the same handle.
+ *
+ * Thread-safe through core synchronization. Returns 0 on success or a negative
+ * mpv_error. A NULL ctx is MPV_ERROR_INVALID_PARAMETER.
+ */
+MPV_EXPORT int mpv_lumen_set_audio_callback(mpv_handle *ctx,
+                                           mpv_lumen_audio_callback callback,
+                                           void *opaque);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/player/client.c b/player/client.c
--- a/player/client.c
+++ b/player/client.c
@@ -46,6 +46,7 @@
 #include "command.h"
 #include "core.h"
 #include "client.h"
+#include "mpv/lumen.h"
 
 /*
  * Locking hierarchy:
@@ -81,6 +82,13 @@
     int num_custom_protocols;
 
     struct mpv_render_context *render_context;
+
+    // Separate from lock: held during callbacks so unregister waits for them.
+    // The API setter also holds the core lock. Callback must never reenter mpv.
+    mp_mutex lumen_lock;
+    struct mpv_handle *lumen_owner;
+    mpv_lumen_audio_callback lumen_callback;
+    void *lumen_opaque;
 };
 
 struct observe_property {
@@ -184,6 +192,7 @@
     };
     mpctx->global->client_api = mpctx->clients;
     mp_mutex_init(&mpctx->clients->lock);
+    mp_mutex_init(&mpctx->clients->lumen_lock);
 }
 
 void mp_clients_destroy(struct MPContext *mpctx)
@@ -200,6 +209,7 @@
     }
 
     mp_mutex_destroy(&mpctx->clients->lock);
+    mp_mutex_destroy(&mpctx->clients->lumen_lock);
     talloc_free(mpctx->clients);
     mpctx->clients = NULL;
 }
@@ -389,6 +399,39 @@
     mp_dispatch_unlock(ctx->mpctx->dispatch);
 }
 
+int mpv_lumen_set_audio_callback(mpv_handle *ctx,
+                                mpv_lumen_audio_callback callback, void *opaque)
+{
+    if (!ctx)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    lock_core(ctx);
+    struct mp_client_api *api = ctx->clients;
+    mp_mutex_lock(&api->lumen_lock);
+    int result = 0;
+    if (callback && api->lumen_owner && api->lumen_owner != ctx) {
+        result = MPV_ERROR_INVALID_PARAMETER;
+    } else if (callback || api->lumen_owner == ctx) {
+        api->lumen_owner = callback ? ctx : NULL;
+        api->lumen_callback = callback;
+        api->lumen_opaque = callback ? opaque : NULL;
+    }
+    mp_mutex_unlock(&api->lumen_lock);
+    unlock_core(ctx);
+    return result;
+}
+
+void mp_client_lumen_audio(struct mp_client_api *api, const float *pcm,
+                          int samples, int rate, int channels, double pts)
+{
+    if (!api)
+        return;
+    mp_mutex_lock(&api->lumen_lock);
+    if (api->lumen_callback)
+        api->lumen_callback(api->lumen_opaque, pcm, samples, rate, channels, pts);
+    mp_mutex_unlock(&api->lumen_lock);
+}
+
 void mpv_wait_async_requests(mpv_handle *ctx)
 {
     mp_mutex_lock(&ctx->lock);
@@ -430,6 +473,16 @@
     struct mp_client_api *clients = ctx->clients;
 
     MP_DBG(ctx, "Destroying client handle...\n");
+
+    // Also used on the core thread by scripting: do not take the dispatch lock.
+    // Holding lumen_lock drains delivery before the owner/opaque can go away.
+    mp_mutex_lock(&clients->lumen_lock);
+    if (clients->lumen_owner == ctx) {
+        clients->lumen_owner = NULL;
+        clients->lumen_callback = NULL;
+        clients->lumen_opaque = NULL;
+    }
+    mp_mutex_unlock(&clients->lumen_lock);
 
     if (terminate)
         mpv_command(ctx, (const char*[]){"quit", NULL});
